<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow HTTPS to all domains (default) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- YouTube / GoogleVideo CDN use HTTPS only — no cleartext needed -->
</network-security-config>
